<!doctype html><html lang="es"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="description" content="Información y horarios de actividades deportivas del Centro Militar." /><title>Actividades deportivas | Centro Militar</title></head>
<body><a class="skip" href="#contenido">Ir al contenido</a>
  <header class="header"><div class="wrap header-inner"><a class="brand" href="/" aria-label="Centro Militar, inicio"><img src="/images/escudo.jfif" alt="" /><span>Centro Militar<small>Montevideo · Uruguay</small></span></a>
    <nav aria-label="Navegación principal"><a href="/">Inicio</a><a href="/alojamientos/">Alojamientos</a><a href="/documentos/">Documentos</a><a href="/comision-directiva/">Comisión Directiva</a><a href="/servicios/">Servicios</a><a href="/actividades-deportivas/" aria-current="page">Deportes</a><a href="/sociocultural/">Sociocultural</a><a href="/#contacto">Contacto</a></nav></div></header>
