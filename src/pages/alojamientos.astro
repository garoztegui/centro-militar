  ['IMG_1525.jpg', 'Cabaña en Termas del Arapey'],
  ['IMG_1528.jpg', 'Cabaña y parque en Termas del Arapey'],
  ['IMG_1529.jpg', 'Cabaña en Termas del Arapey'],
  ['IMG_1533.jpg', 'Dormitorio de una cabaña'],
  ['IMG_1537.jpg', 'Cocina de una cabaña'],
