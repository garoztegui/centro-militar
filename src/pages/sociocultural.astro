---
const local = '/legacy/SocioCultural/imag/';
const source = 'https://www.centromilitar.org.uy/SocioCultural/imag/';
const notices = [
  { title: 'Departamento Sociocultural', image: 'SocioCultural.jpg' },
  { title: 'Cena Aniversario', image: 'CenaAniversario.jpg' },
  { title: 'Paseo a Punta del Este', image: 'PaseoPtadelEste.jpg' },
  { title: 'Fin de curso 2024', image: 'FinDeCurso2024.jpg', video: 'FinDeCurso2024.mp4' },
  { title: 'Ballet', image: 'Ballet.jpg' },
  { title: 'Teatro', image: 'TeatroParaCartelera.jpg' },
  { title: 'Coro', image: 'CORO.jpg' },
  { title: 'Departamento Sociocultural', image: 'DptoSocioCultural.jpg' },
  { title: 'Peluquería', image: 'Peluqueria.jpg' },
  { title: 'Encuentro de coros', image: 'EncuentrodeCoros.jpg' },
  { title: 'Tardes literarias', image: 'TardesLiterarias.jpg' },
  { title: 'Actividades', image: 'ACTIVIDADES.jpg' },
  { title: 'Taller de dibujo y pintura', image: 'TallerDibuyPint.jpg' },
  { title: 'Fiesta de la cerveza', image: 'FiestadelaCerveza.jpg', video: 'FiestadelaCerveza.mp4' },
  { title: 'Salones para fiestas y eventos', image: 'SalonesParaFiestasyEventos.jpg', video: 'SalonesParaFiestasyEventos.mp4' },
  { title: 'Exposición pictórica', image: 'ExpPict.jpg', video: 'ExpPict.mp4' },
  { title: 'Noche de vinos', image: 'NochedeVinos.jpg', video: 'NochedeVinos.mp4' },
  { title: 'Coro Centro Militar', image: 'CoroCentroMilitar.jpg', video: 'CoroCentroMilitar.mp4' },
];
---
<!doctype html><html lang="es"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="description" content="Actividades y novedades socioculturales del Centro Militar." /><title>Sociocultural | Centro Militar</title></head>
<body><a class="skip" href="#contenido">Ir al contenido</a>
  <header class="header"><div class="wrap header-inner"><a class="brand" href="/" aria-label="Centro Militar, inicio"><img src="/images/escudo.jfif" alt="" /><span>Centro Militar<small>Montevideo · Uruguay</small></span></a>
    <nav aria-label="Navegación principal"><a href="/">Inicio</a><a href="/alojamientos/">Alojamientos</a><a href="/documentos/">Documentos</a><a href="/comision-directiva/">Comisión Directiva</a><a href="/servicios/">Servicios</a><a href="/actividades-deportivas/">Deportes</a><a href="/sociocultural/" aria-current="page">Sociocultural</a><a href="/#contacto">Contacto</a></nav></div></header>
  <main id="contenido"><section class="intro"><div class="wrap"><p class="eyebrow">Centro Militar</p><h1>Sociocultural</h1><p>Actividades y novedades del Departamento Sociocultural.</p></div></section>
    <div class="wrap content"><section><p class="eyebrow">Información publicada</p><h2>Cursos, clases y talleres</h2><p>Actividades presenciales y online, según la información del sitio original.</p><div class="schedule"><article><h3>Dibujo y pintura</h3><p>Martes de 14:00 a 17:00 hs.</p></article><article><h3>Ballet para niñas</h3><p>Martes y jueves de 18:10 a 18:55 hs. y de 18:55 a 19:40 hs.</p></article><article><h3>Ensayo coral</h3><p>Miércoles de 17:00 a 18:30 hs.</p></article></div><p><a class="document" href={`${local}ActividadesDptoSociocultural.pdf`} download>Descargar información del Departamento Sociocultural · PDF</a></p></section>
      <section class="updates"><p class="eyebrow">Novedades - Sociocultural</p><h2>Actividades y eventos</h2><div class="cards">{notices.map((item) => <article><a href={`${local}${item.image}`}><img src={`${local}${item.image}`} alt="" loading="lazy" /><h3>{item.title}</h3><span class="action">Ver imagen</span></a>{item.video && <a class="video" href={`${source}${item.video}`}>Ver video: {item.title}</a>}</article>)}</div></section>
    </div></main><footer><div class="wrap footer-inner"><span>Centro Militar · Montevideo, Uruguay</span><a href="#contenido">Volver al inicio</a></div></footer>
</body></html>
<style is:global>
  :root { color-scheme: light; font-family: Arial,sans-serif; color: #142b3f; background: white; } * { box-sizing: border-box; } html { scroll-behavior: smooth; } body { margin: 0; line-height: 1.65; } a { color: inherit; } a:focus-visible { outline: 3px solid #c09537; outline-offset: 4px; }
  .skip { position: absolute; left: 1rem; top: -5rem; z-index: 5; padding: .6rem 1rem; background: white; } .skip:focus { top: 1rem; } .wrap { width: min(1180px,calc(100% - 3rem)); margin: 0 auto; }
  .header { border-bottom: 1px solid #e0e7ea; } .header-inner { min-height: 90px; display: flex; align-items: center; justify-content: space-between; gap: 2rem; } .brand { display: inline-flex; align-items: center; gap: .65rem; text-decoration: none; font: 400 1.45rem/1.15 Georgia,serif; } .brand img { width: 72px; height: 72px; object-fit: contain; } .brand small { display: block; margin-top: .35rem; font: 700 .65rem/1.2 Arial,sans-serif; letter-spacing: .14em; text-transform: uppercase; color: #647686; }
  nav { display: flex; flex-wrap: wrap; gap: 1rem 2rem; font-size: .95rem; font-weight: 700; } nav a { text-decoration: none; } nav a:hover,nav a[aria-current] { text-decoration: underline; text-underline-offset: .3em; }
  .intro { background: #112f48; color: white; padding: 4.5rem 0; } .intro p:not(.eyebrow) { color: #e6edf1; font-size: 1.1rem; } .eyebrow { color: #8f6b1e; text-transform: uppercase; letter-spacing: .16em; font-size: .8rem; font-weight: 700; } .intro .eyebrow { color: #e0c781; } h1,h2 { font-family: Georgia,serif; font-weight: 400; line-height: 1.12; } h1 { font-size: clamp(2.7rem,5vw,4.7rem); margin: .7rem 0 1rem; } h2 { font-size: clamp(2rem,3vw,2.8rem); margin: .5rem 0 1.5rem; } h3 { font: 400 1.35rem Georgia,serif; margin: 0 0 .5rem; }
  .content { padding: 5rem 0; } .schedule { display: grid; grid-template-columns: repeat(3,1fr); gap: 1rem; margin: 2rem 0; } .schedule article { background: #f1f5f6; padding: 1.4rem; } .schedule p { margin-bottom: 0; } .document { display: inline-block; background: #eaf0f2; padding: 1rem; font-weight: 700; text-underline-offset: .2em; }
  .updates { margin-top: 6rem; } .cards { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 1rem; } .cards article { border: 1px solid #dce4e7; } .cards article > a:first-child { display: block; padding: 1rem; text-decoration: none; } .cards article > a:hover { background: #f1f5f6; } .cards img { display: block; width: 100%; height: 240px; object-fit: contain; background: #f1f5f6; margin-bottom: 1rem; } .action,.video { color: #34566b; font-size: .9rem; font-weight: 700; } .video { display: block; padding: 0 1rem 1rem; }
  footer { background: #0c2538; color: #e6edf1; padding: 1.6rem 0; font-size: .9rem; } .footer-inner { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 1rem; }
  @media (max-width: 720px) { .header-inner { padding: 1rem 0; align-items: flex-start; flex-direction: column; gap: 1rem; } .brand img { width: 64px; height: 64px; } .content { padding: 3.5rem 0; } .schedule { grid-template-columns: 1fr; } .cards { grid-template-columns: repeat(2,minmax(0,1fr)); } .cards img { height: 180px; } .updates { margin-top: 4rem; } }
  @media (max-width: 420px) { .cards { grid-template-columns: 1fr; } }
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
</style>
