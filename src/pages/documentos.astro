---
const groups = [
  { title: 'Afiliaciones', documents: [
    ['Ingreso Socio Militar', 'IngresoSocioMilitar.doc'],
    ['Ingreso de Socios Civiles Suscriptores', 'IngresoCivilesSuscriptores.doc'],
    ['Ingreso de Beneficiario Escuela y LMGA', 'IngresoBeneficiarioEscuelayLMGA.doc'],
    ['Ingreso de Beneficiarios de Socios', 'Ingresodebeneficiariosdesocios.doc'],
    ['Ingreso Socio de Verano', 'IngresoSociodeVerano.doc'],
    ['Ingreso de Suscriptora Clase IIa', 'IngresodeSuscriptoraClaseIIa.doc'],
    ['Ingreso Socio Transeunte', 'IngresoSocioTranseunte.doc'],
    ['Ingreso de Socio de Verano Beneficiario', 'SociodeVeranoBENEFICIARIO.doc'],
  ] },
  { title: 'Solicitudes y trámites', documents: [
    ['Alta Licencia', 'AltaLicencia.doc'],
    ['Cambio de Categoria', 'CambCat.doc'],
    ['Licencia de Socio', 'Licencia.doc'],
    ['Baja de Beneficiario', 'BajaBenef.doc'],
    ['Solicitud de Baja', 'Solicituddebaja.doc'],
    ['Formulario Solicitud de Salones', 'FormularioSolicituddeSalones.doc'],
    ['Formulario Anulación Salones', 'FormularioAnulacionSalones.doc'],
    ['Reservas Complejo de Vacaciones Termas del Arapey', 'ReservaTermas.doc'],
    ['Cancelacion de Reserva de Termas del Arapey', 'CancelacionTermasdelArapey.doc'],
  ] },
];
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Descargá los documentos y formularios del Centro Militar." />
    <title>Documentos y formularios | Centro Militar</title>
  </head>
  <body>
    <a class="skip" href="#contenido">Ir al contenido</a>
    <header class="header"><div class="wrap header-inner">
      <a class="brand" href="/" aria-label="Centro Militar, inicio"><img src="/images/escudo.jfif" alt="" /><span>Centro Militar<small>Montevideo · Uruguay</small></span></a>
      <nav aria-label="Navegación principal"><a href="/">Inicio</a><a href="/alojamientos/">Alojamientos</a><a href="/documentos/" aria-current="page">Documentos</a><a href="/comision-directiva/">Comisión Directiva</a><a href="/servicios/">Servicios</a><a href="/actividades-deportivas/">Deportes</a><a href="/sociocultural/">Sociocultural</a><a href="/#contacto">Contacto</a></nav>
    </div></header>
    <main id="contenido">
      <section class="intro"><div class="wrap"><p class="eyebrow">Centro Militar</p><h1>Documentos y formularios</h1><p>Encontrá los formularios disponibles para descargar.</p></div></section>
      <div class="wrap content">
        {groups.map((group) => <section class="document-group"><h2>{group.title}</h2><ul>{group.documents.map(([label, file]) => <li><a href={`/legacy/AfiliacionesDocVarios/${file}`} download><span>{label}</span><span class="download">Descargar <span aria-hidden="true">· DOC</span><span class="sr-only"> archivo DOC</span></span></a></li>)}</ul></section>)}
      </div>
    </main>
    <footer><div class="wrap footer-inner"><span>Centro Militar · Montevideo, Uruguay</span><a href="#contenido">Volver al inicio</a></div></footer>
  </body>
</html>
<style is:global>
  :root { color-scheme: light; font-family: Arial, sans-serif; color: #142b3f; background: #fff; } * { box-sizing: border-box; } html { scroll-behavior: smooth; } body { margin: 0; line-height: 1.65; } a { color: inherit; } a:focus-visible { outline: 3px solid #c09537; outline-offset: 4px; }
  .skip { position: absolute; left: 1rem; top: -5rem; z-index: 5; padding: .6rem 1rem; background: white; } .skip:focus { top: 1rem; } .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
  .wrap { width: min(1180px, calc(100% - 3rem)); margin: 0 auto; } .header { border-bottom: 1px solid #e0e7ea; } .header-inner { min-height: 90px; display: flex; align-items: center; justify-content: space-between; gap: 2rem; }
  .brand { display: inline-flex; align-items: center; gap: .65rem; text-decoration: none; font: 400 1.45rem/1.15 Georgia, serif; } .brand img { width: 72px; height: 72px; object-fit: contain; } .brand small { display: block; margin-top: .35rem; font: 700 .65rem/1.2 Arial, sans-serif; letter-spacing: .14em; text-transform: uppercase; color: #647686; }
  nav { display: flex; flex-wrap: wrap; gap: 1rem 2rem; font-size: .95rem; font-weight: 700; } nav a { text-decoration: none; } nav a:hover, nav a[aria-current] { text-decoration: underline; text-underline-offset: .3em; }
  .intro { background: #112f48; color: white; padding: 4.5rem 0; } .intro p:not(.eyebrow) { color: #e6edf1; font-size: 1.1rem; } .eyebrow { color: #e0c781; text-transform: uppercase; letter-spacing: .16em; font-size: .8rem; font-weight: 700; } h1,h2 { font-family: Georgia,serif; font-weight: 400; line-height: 1.12; } h1 { font-size: clamp(2.7rem,5vw,4.7rem); margin: .7rem 0 1rem; } h2 { font-size: clamp(2rem,3vw,2.8rem); margin: 0 0 1.5rem; }
  .content { max-width: 930px; padding: 4.5rem 0 5rem; } .document-group + .document-group { margin-top: 4rem; } ul { list-style: none; margin: 0; padding: 0; border-top: 1px solid #dce4e7; } li { border-bottom: 1px solid #dce4e7; } li a { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; padding: 1.1rem .5rem; text-decoration: none; } li a:hover { background: #f1f5f6; } .download { color: #34566b; font-size: .9rem; font-weight: 700; white-space: nowrap; }
  footer { background: #0c2538; color: #e6edf1; padding: 1.6rem 0; font-size: .9rem; } .footer-inner { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 1rem; }
  @media (max-width: 720px) { .header-inner { padding: 1rem 0; align-items: flex-start; flex-direction: column; gap: 1rem; } .brand img { width: 64px; height: 64px; } .content { padding-top: 3rem; padding-bottom: 3.5rem; } li a { align-items: flex-start; flex-direction: column; gap: .2rem; } }
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
</style>
