const phones = [
  { label: '(+598) 2908 1541', number: '29081541' },
  { label: '(+598) 2908 1741', number: '29081741' },
  { label: '(+598) 2908 1482', number: '29081482' },
  { label: '(+598) 2908 1644', number: '29081644' },
